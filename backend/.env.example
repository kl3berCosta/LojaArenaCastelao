# Desenvolvimento local. Copie para .env e exporte as variáveis (ou use `node --env-file=.env server.js`).
# Em produção (NODE_ENV=production) ADMIN_PASSWORD e JWT_SECRET são OBRIGATÓRIOS.
PORT=3000
# NODE_ENV=production
ADMIN_PASSWORD=
JWT_SECRET=

AWS_REGION=us-east-1
# Na EC2 as credenciais vêm da IAM Role: NÃO defina AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY lá.
# Recursos AWS ficam desligados (modo local) enquanto a variável estiver vazia/ausente.
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# Valores do docker-compose.yml deste repositório (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/stadiumdb
REDIS_URL=redis://localhost:6379
