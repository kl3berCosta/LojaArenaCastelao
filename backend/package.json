{
  "name": "stadium-ticket-store-api",
  "version": "1.0.0",
  "description": "API para loja virtual de ingressos de futebol com arquitetura AWS desacoplada",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "worker:once": "node worker.js --once",
    "dev": "node --watch server.js",
    "test": "node --test --test-force-exit test-api.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1150.0",
    "@aws-sdk/client-cloudwatch": "^3.1150.0",
    "@aws-sdk/client-dynamodb": "^3.1150.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/client-sns": "^3.1150.0",
    "@aws-sdk/client-sqs": "^3.1150.0",
    "@aws-sdk/lib-dynamodb": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "sharp": "^0.35.5"
  }
}
